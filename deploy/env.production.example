# /opt/hootroute/.env on the VPS. chmod 600. Never commit it, never paste its values in chat or screenshots.
# setup_vps.sh fills HOOTROUTE_ENV, PUBLIC_URL, CORS_ORIGINS and generates ADMIN_TOKEN / BRIDGE_SECRET.

HOOTROUTE_ENV=production
PUBLIC_URL=
CORS_ORIGINS=
ADMIN_TOKEN=
BRIDGE_SECRET=
RATE_LIMITS=1
ALLOW_DEMO_ROOMS=0
AGENT_RUNTIME=inprocess
POSITION_RETENTION_HOURS=24
APIFY_DAILY_RUNS=25
EVIDENCE_TTL_HOURS=12
EVIDENCE_STALE_DAYS=30

# Providers (copy from your local .env)
ANTHROPIC_API_KEY=
HEAD_MODEL=claude-sonnet-5-5
HEAD_REPORT_MODEL=claude-haiku-5-5
APIFY_TOKEN=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
APP_NAME=HootRoute

# Frontend (baked into the build; Geoapify keys are public: restrict this one to your domain in the Geoapify dashboard)
VITE_GEOAPIFY_KEY=
VITE_GPS=real
