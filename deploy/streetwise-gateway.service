[Unit]
Description=Streetwise gateway (FastAPI, rooms, engine, in-process agents)
After=network-online.target

[Service]
User=streetwise
WorkingDirectory=/opt/streetwise/services/api
ExecStart=/opt/streetwise/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
