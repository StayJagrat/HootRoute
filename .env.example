# Copy to .env (git-ignored) and fill in. The gateway reads this file directly; never `source` it into a shell.
# Every provider is optional: without a key the feature reports "not configured" and the walk carries on.

# Public HTTPS origin of the app. Used in guardian links and SMS. Leave empty in local development.
PUBLIC_URL=
# Control-room token. Empty = /room and GET /api/walks are open (local development only). Set it in production
# and open the control room once with /room?admin=<token> (the browser remembers it).
ADMIN_TOKEN=
# SQLite file for walks, room history, GPS traces, alerts, shop declarations and audits.
DB_PATH=
# GPS fixes of ended walks are deleted after this many hours.
POSITION_RETENTION_HOURS=24
# Relay unregistered rooms (the offline DemoEngine, ?agents=demo). Set 0 in production if you never run the cached demo.
ALLOW_DEMO_ROOMS=1
CORS_ORIGINS=*

# Where the agents run: inprocess (default, inside the gateway) or uagents (services/agents/live_bureau.py, registered on Agentverse).
AGENT_RUNTIME=inprocess
UAGENTS_BRIDGE_URL=http://127.0.0.1:8110
# Shared secret between the gateway and live_bureau.py. Required when AGENT_RUNTIME=uagents.
BRIDGE_SECRET=

# Guardian SMS backup (Twilio). Trial accounts can text verified numbers only. Never used to contact emergency services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Voice out (Cartesia Sonic). Without a key the phone uses its own speech.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6

# Block imagery explanation on the control room (optional, never a score input)
MAPILLARY_TOKEN=
ANTHROPIC_API_KEY=

# HootRoute
APP_NAME=HootRoute
# The Head (Claude). Without a key a fixed pipeline runs and says so.
HEAD_MODEL=claude-sonnet-5-5
HEAD_REPORT_MODEL=claude-haiku-5-5
# Live hours check (Checker) uses APIFY_TOKEN above. HOURS_CHECK_MOCK=1 is for offline tests only.
