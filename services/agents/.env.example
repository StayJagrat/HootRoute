# Copy to .env (git-ignored). Seeds are private keys: an agent's address is derived from its seed, so keep them stable.
# Generate one: python -c "import secrets; print(secrets.token_hex(24))"
HEAD_SEED=
GUIDE_SEED=
CHECKER_SEED=
RESCUER_SEED=

# The HootRoute gateway the Head calls (local: http://localhost:8000; deployed: https://your-domain)
ENGINE_URL=http://localhost:8000
# Public origin used in the walker/guardian links the Head sends in chat
PUBLIC_URL=

# mailbox (default): connect through the Agentverse mailbox and publish the profile. local: offline tests only.
STREETWISE_MODE=mailbox
BUREAU_PORT=8100
